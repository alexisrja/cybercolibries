# URL pública del sitio (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://cybercolibries.org

# --- Analítica (opcional) -------------------------------------------------
# plausible | umami | ga
NEXT_PUBLIC_ANALYTICS_PROVIDER=
# Plausible: dominio registrado. Umami: no se usa.
NEXT_PUBLIC_ANALYTICS_DOMAIN=
# Plausible self-hosted o Umami: URL del script
NEXT_PUBLIC_ANALYTICS_SCRIPT_URL=
# Umami: website id · GA4: measurement id (G-XXXX)
NEXT_PUBLIC_ANALYTICS_SITE_ID=

# --- Formulario de contacto -----------------------------------------------
# Webhook que recibe los mensajes (n8n, Make, Zapier, Slack, Supabase Edge Function…)
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_SECRET=

# --- Métricas de impacto (opcional) ---------------------------------------
# Endpoint JSON con { metrics: Metric[], updatedAt: string }
METRICS_API_URL=

# --- Futuro: Supabase -----------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
